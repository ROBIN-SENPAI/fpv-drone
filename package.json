{
  "name": "fpv-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Physically based FPV drone flight simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx tools/bench.ts",
    "dynamics": "tsx tools/dynamics.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "homepage": "https://robin-senpai.github.io/fpv-drone/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ROBIN-SENPAI/fpv-drone.git"
  },
  "bugs": {
    "url": "https://github.com/ROBIN-SENPAI/fpv-drone/issues"
  },
  "keywords": [
    "fpv",
    "drone",
    "quadcopter",
    "simulator",
    "physics",
    "betaflight",
    "threejs",
    "webgl",
    "typescript"
  ]
}
